# Copy to `.env` (gitignored) and replace every `change-me`.
# Read by docker-compose.yml and by the server (application.conf overrides).

PORT=8080
HOST=0.0.0.0

DB_URL=jdbc:postgresql://localhost:5432/prorab
DB_USER=prorab
DB_PASSWORD=change-me

STORAGE_DIR=./data/uploads

# The bearer token the app sends. Any long random string.
API_TOKEN=change-me

# Turns an address into a point on the map. Unset: OpenStreetMap's public Nominatim, which
# sees the addresses of your objects. `off` keeps every address on this machine (no pins then).
# GEOCODER_URL=https://nominatim.openstreetmap.org

# Where addresses without a city are looked for first (latitude,longitude). Default: Yekaterinburg.
# A city written in the address still wins ("Пермь, Ленина 5"). `off` removes the preference.
# GEOCODER_NEAR=56.8389,60.6057
# The built web app, served by this server at /. Build it with
#   ./gradlew :web:wasmJsBrowserDistribution
# then open http://<this computer>:8080/ in a browser and type the API token into the settings.
WEB_DIR=./web/build/dist/wasmJs/productionExecutable
